# Producción — valores de ejemplo. Copiar a terraform.tfvars.
# NO incluir secretos: los secretos viven en SSM Parameter Store (SecureString),
# cargados FUERA de Terraform. Los valores sensibles se marcan como PENDING_SECURE_INPUT.

project_name = "afiliaciones"
environment  = "prod"
aws_region   = "us-east-2"

# Red (CIDR_PENDING_ORGANIZATIONAL_CONFIRMATION)
vpc_cidr                = "10.30.0.0/16"
availability_zones      = ["us-east-2a", "us-east-2b"]
public_subnet_cidrs     = ["10.30.0.0/24", "10.30.1.0/24"]
private_db_subnet_cidrs = ["10.30.10.0/24", "10.30.11.0/24"]

# Compute (ASG: 2 instancias espejo, sin autoscaling dinámico)
instance_type         = "t3.small"
root_volume_size_gb   = 20
asg_min_size          = 2
asg_max_size          = 2
asg_desired_capacity  = 2
app_image_tag         = "pending"   # se actualiza en cada deploy (digest inmutable)

# Observabilidad
log_retention_days = 30

# RDS Single-AZ
rds_instance_class          = "db.t4g.micro"
rds_allocated_storage       = 20
rds_max_allocated_storage   = 100
rds_backup_retention_period = 14

# DNS / ACM (PENDING_APPROVAL). Habilitar solo con dominio y hosted zone aprobados.
create_dns       = false
prod_domain_name = null
hosted_zone_id   = null

# Protección de origen CloudFront → ALB (PENDING_SECURE_INPUT: reemplazar antes de apply)
# Protección de origen CloudFront → ALB (obligatorio; usar valor aleatorio de alta entropía)
# origin_protect_header_value = "<PENDING_SECURE_INPUT>"

# WAF
enable_waf_rate_limit = true
waf_rate_limit        = 1000

# Parámetros SecureString esperados (valores cargados fuera de Terraform)
# secure_parameter_names = [ ... ]

# Parámetros no sensibles adicionales
non_secret_parameters = {}

additional_tags = {}
