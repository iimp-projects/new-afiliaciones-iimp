# Terraform local state and caches
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files with real values (never commit)
*.tfvars
*.tfvars.json
!*.tfvars.example

# CLI configuration
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan artifacts
*.tfplan
