# Plantilla de variables de entorno (solo billeteras digitales).
# Copiar a .env y completar localmente. NUNCA commitear valores reales.

# ---- Flags y sincronizacion ----
CARD_WALLET_LOCAL_SIMULATION=true
CARD_WALLET_SYNC_ENABLED=true
CARD_WALLET_SYNC_BATCH_SIZE=25
CARD_WALLET_SYNC_MAX_ATTEMPTS=8
CARD_WALLET_SYNC_LEASE_SECONDS=120
CARD_WALLET_SYNC_INTERVAL_SECONDS=60

CARD_GOOGLE_WALLET_ENABLED=true
CARD_APPLE_WALLET_ENABLED=true
CARD_GOOGLE_WALLET_MODE=REAL
CARD_APPLE_WALLET_MODE=SIMULATION

# ---- Google Wallet ----
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_CREDENTIALS_FILE=
GOOGLE_WALLET_CLASS_AUTO_CREATE=true

# ---- Apple Wallet ----
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_ORGANIZATION_NAME="Instituto de Ingenieros de Minas del Peru"

# Credenciales (precedencia: _B64 > _PEM > _FILE; no mezclar contenidos distintos)
APPLE_WALLET_PASS_CERT_FILE=
APPLE_WALLET_PASS_KEY_FILE=
APPLE_WALLET_WWDR_CERT_FILE=
APPLE_WALLET_PASS_CERT_B64=
APPLE_WALLET_PASS_KEY_B64=
APPLE_WALLET_WWDR_CERT_B64=
APPLE_WALLET_PASS_CERT_PEM=
APPLE_WALLET_PASS_KEY_PEM=
APPLE_WALLET_WWDR_CERT_PEM=

# Passphrase de la key cifrada (ingreso manual; nunca en argumentos ni logs)
APPLE_WALLET_PASS_KEY_PASSPHRASE=
# Ruta opcional al binario openssl (si vacio, se resuelve por PATH)
APPLE_WALLET_OPENSSL_PATH=

# Capacidad de actualizacion (false = pase estatico; default true)
APPLE_WALLET_UPDATES_ENABLED=false
# PassKit Web Service (solo con actualizaciones ON; debe ser https)
APPLE_WALLET_WEB_SERVICE_URL=
CARD_WALLET_PASS_AUTH_SECRET=
CARD_WALLET_PASS_AUTH_SECRET_VERSION=1
CARD_WALLET_PASS_AUTH_SECRET_PREVIOUS=
CARD_WALLET_PASS_AUTH_SECRET_PREVIOUS_VERSION=
# APNs (opcional; requiere actualizaciones ON)
APPLE_WALLET_APNS_KEY_ID=
APPLE_WALLET_APNS_TEAM_ID=
APPLE_WALLET_APNS_KEY_B64=
